{
  "name": "greensmart-landing",
  "version": "1.0.0",
  "description": "GreenSmart - 智能自动浇水花盆官方网站",
  "main": "index.html",
  "scripts": {
    "dev": "npm run build && wrangler pages dev",
    "dev:init": "wrangler d1 execute DB --local --file=./schema.sql",
    "build": "node build.js",
    "start": "npm run dev",
    "verify": "npm run qa:source && npm run build && npm run qa:dist && npm run qa:schema",
    "qa:check": "npm run qa:source",
    "qa:source": "node qa-check.js --source",
    "qa:dist": "node qa-check.js --dist",
    "qa:schema": "node schema-check.js",
    "fetch-trends": "node scripts/fetch-trends.js"
  },
  "keywords": [
    "smart",
    "planter",
    "self-watering",
    "garden",
    "iot"
  ],
  "author": "GreenSmart Team",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.4",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "google-trends-api": "^4.9.2"
  }
}
