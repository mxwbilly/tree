# Legacy Node server variables are intentionally not used. For local Pages
# Functions development, copy `.dev.vars.example` to `.dev.vars` instead.
JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# Cloudflare Turnstile (required for inquiry submissions)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional email notification settings
NOTIFY_EMAIL=

# Resend (Cloudflare production email notifications)
RESEND_API_KEY=
MAIL_FROM=GreenSmart <noreply@novagardenhome.com>
